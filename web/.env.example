# Browser (Vite) – public values
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server (api/process.ts) – secrets, also set these in Vercel project settings
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ANTHROPIC_API_KEY=sk-ant-...
# Azure portal → your Speech resource → Keys and Endpoint
AZURE_SPEECH_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_LOCALE=en-US
MAAZIN_MODEL=claude-haiku-5-5
# Public address of this app, used for the links on Jason tasks. Defaults to the request's address.
MAAZIN_WEB_URL=
# Per-user monthly caps
MAAZIN_MAX_AUDIO_MINUTES=600
MAAZIN_MAX_NOTE_RUNS=100
